---
import Navbar from '../components/sections/Navbar.astro';
import CrispChat from '../components/integration/CrispChat.astro';
import { siteConfig } from '../config/site';

import '../styles/variables.css';
import '../styles/global.css';
import '../styles/animations.css';

const { title = siteConfig.name, description = siteConfig.description } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — {siteConfig.headline}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — ${siteConfig.headline}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.url} />
    
    <slot name="head" />
  </head>
  <body class="animate-fade-in">
    <a href="#pain-points" class="skip-link">Ir al contenido principal</a>
    <Navbar />
    <slot />
    <CrispChat />
  </body>
</html>
