---
interface Props {
  pages?: string[];
}

// Rutas donde se mostrará el chat. Modifica el array en Layout.astro para controlar esto.
const { pages = ['/'] } = Astro.props;
const show = pages.includes(Astro.url.pathname);
---

{show && (
  <script is:inline>
    window.$crisp=[];window.CRISP_WEBSITE_ID="78906fea-4ba5-4f8b-a8da-df9819d60279";(function(){d=document;s=d.createElement("script");s.src="https://client.crisp.chat/l.js";s.async=1;d.getElementsByTagName("head")[0].appendChild(s);})();
  </script>
)}
