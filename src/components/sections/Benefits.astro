---
import { siteConfig } from '../../config/site';
import StatCard from '../ui/StatCard.astro';
import Button from '../ui/Button.astro';
import { Stethoscope, CalendarCheck, ShieldCheck, UserRound } from 'lucide-astro';

const { benefits } = siteConfig;
const roles = benefits.rolesSection.roles.filter(role => role.name !== "Administrador");

const RoleIconMap: Record<string, any> = {
  stethoscope: Stethoscope,
  'calendar-check': CalendarCheck,
  'shield-check': ShieldCheck,
  'user-round': UserRound,
};

// Colores del diseño anterior para los roles
const roleColors = [
  { accent: "#2563eb", bgSoft: "rgba(37, 99, 235, 0.05)" }, // Azul
  { accent: "#8b5cf6", bgSoft: "rgba(139, 92, 246, 0.05)" }, // Violeta
  { accent: "#ec4899", bgSoft: "rgba(236, 72, 153, 0.05)" }, // Rosa
  { accent: "#06b6d4", bgSoft: "rgba(6, 182, 212, 0.05)" }  // Cian
];
---

<section id="benefits" class="benefits">
  <!-- Imágenes decorativas -->
  <div class="tooth-image-container">
    <img src="/images/diente.webp" alt="Diente decorativo" class="tooth-img" />
  </div>

  <div class="compu-image-container">
    <img src="/images/Compu.webp" alt="Computadora decorativa" class="compu-img" />
  </div>

  <div class="container relative z-10">
    <!-- Header Section -->
    <div class="benefits__header">
      <span class="benefits__tag">{benefits.eyebrow}</span>
      <h2 class="benefits__title">
        {benefits.headline}
      </h2>
      <p class="benefits__description">
        {benefits.subheadline}
      </p>
    </div>

    <!-- Metrics Grid -->
    <div class="benefits__metrics">
      {
        benefits.metrics.map((metric) => (
          <StatCard value={metric.value} label={metric.label} />
        ))
      }
    </div>

    <!-- Roles Section -->
    <div class="roles">
      <div class="roles__header">
        <h3 class="roles__title">{benefits.rolesSection.title}</h3>
        <p class="roles__subtitle">{benefits.rolesSection.subtitle}</p>
      </div>

      <div class="benefits-grid">
        {
          roles.map((role, index) => {
            const RoleIcon = RoleIconMap[role.icon];
            return (
            <div
              class="benefit-card js-card"
              style={`--accent: ${roleColors[index].accent}; --bg-soft: ${roleColors[index].bgSoft}; --stagger: ${index}`}
            >
              <div class="card-num">0{index + 1}</div>
              <div class="icon-wrapper">
                {RoleIcon && <RoleIcon size={24} />}
              </div>
              <h4 class="card-title">{role.name}</h4>
              <ul class="role-list">
                {role.perms.map((perm) => (
                  <li class="role-item">
                    <svg class="role-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>{perm}</span>
                  </li>
                ))}
              </ul>
              <div class="card-indicator"></div>
            </div>
            );
          })
        }
      </div>
    </div>

    <!-- CTA Section Perfeccionada -->
    <div class="benefits__cta">
      <div class="modern-cta">
        <div class="modern-cta__glass"></div>
        <div class="modern-cta__content">
          <div class="modern-cta__text">
            <h3 class="modern-cta__title">{benefits.cta.headline}</h3>
            <p class="modern-cta__body">{benefits.cta.body}</p>
          </div>
          <div class="modern-cta__action">
            <Button
              variant="cta"
              class="cta-button-premium animate-pulse-glow"
              onclick="window.$crisp && window.$crisp.push(['do', 'chat:open'])"
            >
              <span class="btn-text">{benefits.cta.btnText}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </Button>
            <p class="cta-note">Respuesta inmediata vía chat</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .benefits {
    padding: var(--space-2xl) 0;
    background:
      radial-gradient(ellipse at 92% 15%, rgba(37, 99, 235, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse at 8% 85%, rgba(14, 116, 144, 0.04) 0%, transparent 50%),
      var(--color-bg);
    position: relative;
    overflow: hidden;
    color: var(--color-text);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* Content sits above decorative images */
  .benefits > .container {
    position: relative;
    z-index: 2;
  }

  /* Imágenes decorativas */
  .tooth-image-container {
    position: absolute;
    top: 2%;
    right: -4%;
    width: 380px;
    opacity: 0.07;
    z-index: 0;
    pointer-events: none;
    transform: rotate(15deg);
    transition: opacity 0.3s ease;
  }

  [data-theme="dark"] .tooth-image-container {
    opacity: 0.11;
  }

  .compu-image-container {
    position: absolute;
    bottom: 2%;
    left: -5%;
    width: 360px;
    opacity: 0.07;
    z-index: 0;
    pointer-events: none;
    transform: rotate(-15deg);
    transition: opacity 0.3s ease;
  }

  [data-theme="dark"] .compu-image-container {
    opacity: 0.11;
  }

  .tooth-img, .compu-img {
    width: 100%;
    height: auto;
  }

  .benefits__header {
    max-width: 800px;
    margin-bottom: var(--space-xl);
    text-align: left;
  }

  .benefits__tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.4rem 1rem 0.4rem 0.7rem;
    background: var(--color-primary-light);
    border: 1px solid var(--color-primary-muted);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .benefits__tag::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--color-primary);
    border-radius: 50%;
    flex-shrink: 0;
    animation: eyebrow-pulse 2.2s ease-in-out infinite;
  }

  @keyframes eyebrow-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.75); }
  }

  .benefits__title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: var(--space-md);
    letter-spacing: -0.03em;
    font-family: var(--font-title);
  }

  .benefits__description {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 60ch;
  }

  /* Métricas */
  .benefits__metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  @media (max-width: 768px) {
    .benefits__metrics {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }

  /* Roles Section */
  .roles {
    margin-top: var(--space-3xl);
  }

  .roles__header {
    margin-bottom: var(--space-xl);
    text-align: left;
  }

  .roles__title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
    font-family: var(--font-title);
  }

  .roles__subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  /* Grid de Beneficios */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0 auto var(--space-2xl);
  }

  .benefit-card {
    background: var(--color-surface);
    padding: 40px 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Ajuste solicitado: NO ponerse blanco en modo oscuro */
  .benefit-card.is-active-carousel {
    background: var(--color-surface);
    transform: translateY(-12px);
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
  }

  [data-theme="dark"] .benefit-card.is-active-carousel {
    background: rgba(255, 255, 255, 0.03);
    border-color: var(--accent);
    box-shadow: 0 0 30px rgba(37, 99, 235, 0.1);
  }

  .benefit-card.is-active-carousel .card-indicator {
    width: 100%;
  }

  .benefit-card.is-active-carousel .icon-wrapper {
    background: var(--accent);
    color: white;
    transform: scale(1.1) rotate(4deg);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
  }

  .card-indicator {
    position: absolute;
    bottom: 0; left: 0; width: 0; height: 4px;
    background: var(--accent);
    transition: width 0.6s ease;
  }

  .icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    color: var(--accent);
    transition: all 0.6s ease;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 16px;
    font-family: var(--font-title);
  }

  .role-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .role-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .role-check {
    flex-shrink: 0;
    color: var(--accent);
    margin-top: 3px;
  }

  .card-num {
    position: absolute;
    top: 16px; right: 18px;
    font-size: 22px;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.18;
    line-height: 1;
    font-family: var(--font-title);
    letter-spacing: -0.02em;
    transition: opacity 0.4s ease, color 0.4s ease;
  }

  .benefit-card:hover .card-num,
  .benefit-card.is-active-carousel .card-num {
    opacity: 0.55;
  }

  /* Hover state — mirrors is-active-carousel */
  .benefit-card:hover {
    transform: translateY(-10px);
    border-color: var(--accent);
    box-shadow: var(--shadow-lg), 0 0 0 1px var(--accent);
  }

  [data-theme="dark"] .benefit-card:hover {
    background: rgba(255, 255, 255, 0.03);
    box-shadow: 0 0 32px color-mix(in srgb, var(--accent) 20%, transparent);
    border-color: var(--accent);
  }

  .benefit-card:hover .card-indicator {
    width: 100%;
  }

  .benefit-card:hover .icon-wrapper {
    background: var(--accent);
    color: white;
    transform: scale(1.1) rotate(4deg);
    box-shadow: 0 8px 20px -4px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* Modern CTA Block - Integración mejorada */
  .benefits__cta {
    margin-top: var(--space-xl);
  }

  .modern-cta {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    position: relative;
    overflow: hidden;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    transition: all 0.3s ease;
  }

  [data-theme="dark"] .modern-cta {
    background: hsl(222, 47%, 5%);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .modern-cta__glass {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle at 100% 0%, var(--color-primary-muted) 0%, transparent 50%),
                radial-gradient(circle at 0% 100%, var(--color-accent-light) 0%, transparent 50%);
    pointer-events: none;
    opacity: 0.5;
  }

  .modern-cta__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    position: relative;
    z-index: 2;
  }

  .modern-cta__text {
    flex: 1;
  }

  .modern-cta__title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
    font-family: var(--font-title);
    color: var(--color-text);
  }

  .modern-cta__body {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    max-width: 50ch;
    line-height: 1.6;
  }

  .modern-cta__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .cta-button-premium {
    background: var(--color-primary) !important;
    color: white !important;
    padding: 1.25rem 2.5rem !important;
    font-size: 1.1rem !important;
    font-weight: 700 !important;
    border-radius: var(--radius-md) !important;
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    transition: all 0.3s ease !important;
    border: none !important;
    box-shadow: var(--shadow-glow);
  }

  .cta-button-premium:hover {
    transform: scale(1.05) translateY(-2px) !important;
    background: var(--color-primary-hover) !important;
  }

  .cta-note {
    font-size: 0.85rem;
    opacity: 0.6;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .modern-cta__content { flex-direction: column; text-align: center; }
  }

  @media (max-width: 768px) {
    .benefits-grid { grid-template-columns: 1fr; }
    .benefits__metrics { grid-template-columns: 1fr; }
    .modern-cta { padding: var(--space-lg) var(--space-md); }
  }
</style>

<script>
  let intervalId = null;
  let observer = null;
  let cards = [];
  let currentIndex = 0;
  let isDesktopMode = null;

  function clearState() {
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }
    if (observer) {
      observer.disconnect();
      observer = null;
    }
    cards.forEach(card => card.classList.remove('is-active-carousel'));
  }

  function nextStep() {
    if (cards.length === 0) return;
    cards.forEach(card => card.classList.remove('is-active-carousel'));
    cards[currentIndex].classList.add('is-active-carousel');
    currentIndex = (currentIndex + 1) % cards.length;
  }

  function startDesktopCarousel() {
    clearState();
    currentIndex = 0;
    nextStep();
    intervalId = setInterval(nextStep, 3500);
  }

  function startMobileObserver() {
    clearState();
    const options = {
      root: null,
      rootMargin: "-40% 0px -40% 0px",
      threshold: 0
    };

    observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          cards.forEach(card => card.classList.remove('is-active-carousel'));
          entry.target.classList.add('is-active-carousel');
        }
      });
    }, options);

    cards.forEach(card => observer.observe(card));
  }

  function handleResponsiveBehavior() {
    cards = Array.from(document.querySelectorAll('.js-card'));
    if (cards.length === 0) return;

    const shouldBeDesktop = window.innerWidth > 768;
    
    if (isDesktopMode !== shouldBeDesktop) {
      isDesktopMode = shouldBeDesktop;
      if (isDesktopMode) {
        startDesktopCarousel();
      } else {
        startMobileObserver();
      }
    }
  }

  function init() {
    isDesktopMode = null;
    handleResponsiveBehavior();

    const grid = document.querySelector('.benefits-grid');
    if (grid) {
      grid.onmouseenter = () => {
        if (isDesktopMode && intervalId) {
          clearInterval(intervalId);
          intervalId = null;
        }
      };
      grid.onmouseleave = () => {
        if (isDesktopMode && !intervalId) {
          intervalId = setInterval(nextStep, 3500);
        }
      };
    }
  }

  if (!window.hasBenefitsResizeListener) {
    window.addEventListener('resize', handleResponsiveBehavior);
    window.hasBenefitsResizeListener = true;
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>
