---
import { siteConfig } from '../../config/site';
import Card from '../ui/Card.astro';
import { Calendar, Activity, Key, Bell, Check, Plus, MessageSquare, Phone, User, Clock } from 'lucide-astro';

const { solution } = siteConfig;

const IconMap = {
  calendar: Calendar,
  activity: Activity,
  key: Key,
  bell: Bell,
};
---

<section id="solution" class="solution">
  <div class="container">
    <p class="solution__eyebrow">{solution.eyebrow}</p>
    <h2 class="solution__headline">{solution.headline}</h2>
    <p class="solution__subheadline">{solution.subheadline}</p>

    <!-- Interactive Dashboard Simulator -->
    <div class="simulator glass animate-border-glow">
      <!-- Left sidebar menu -->
      <div class="simulator__sidebar">
        <div class="simulator__sidebar-header">
          <div class="sidebar-dot red"></div>
          <div class="sidebar-dot yellow"></div>
          <div class="sidebar-dot green"></div>
          <span class="simulator__sidebar-title">Modulos de Elite</span>
        </div>
        <nav class="simulator__nav" aria-label="Navegador del simulador">
          {
            solution.features.map((feat, index) => {
              const IconComponent = IconMap[feat.icon as keyof typeof IconMap];
              return (
                <button
                  class={`simulator__nav-item transition-all-cool ${index === 0 ? 'is-active' : ''}`}
                  data-target={`screen-${feat.num}`}
                  type="button"
                >
                  <span class="nav-item-icon">
                    {IconComponent && <IconComponent size={18} />}
                  </span>
                  <span class="nav-item-text">{feat.title}</span>
                </button>
              );
            })
          }
        </nav>
      </div>

      <!-- Main screen window -->
      <div class="simulator__screen">
        <!-- Header of mockup screen -->
        <div class="simulator__screen-header">
          <div class="simulator__search-bar">
            <span class="search-indicator"></span>
            <span class="search-text">Buscar pacientes, expedientes...</span>
          </div>
          <div class="simulator__user-profile">
            <span class="user-avatar">DR</span>
            <span class="user-name">Dr. García</span>
          </div>
        </div>

        <!-- Dynamic screens wrapper -->
        <div class="simulator__screen-content">
          
          <!-- SCREEN 1: Agenda -->
          <div class="simulator__view transition-screen screen-visible" id="screen-01">
            <div class="agenda-view">
              <div class="agenda-view__header">
                <h4 class="agenda-view__title">Calendario de Sillones</h4>
                <button class="agenda-view__btn btn-mini" type="button">
                  <Plus size={14} /> Nueva Cita
                </button>
              </div>
              <div class="agenda-view__grid">
                <div class="agenda-view__col">
                  <span class="col-title">Sillón A - Principal</span>
                  <div class="agenda-card primary">
                    <span class="agenda-time">09:00 AM</span>
                    <span class="agenda-patient">Roberto Martínez</span>
                    <span class="agenda-treat">Limpieza Ultra</span>
                  </div>
                  <div class="agenda-card secondary">
                    <span class="agenda-time">11:00 AM</span>
                    <span class="agenda-patient">Diana Flores</span>
                    <span class="agenda-treat">Ortodoncia Control</span>
                  </div>
                </div>
                <div class="agenda-view__col">
                  <span class="col-title">Sillón B - Cirugía</span>
                  <div class="agenda-card warning">
                    <span class="agenda-time">10:00 AM</span>
                    <span class="agenda-patient">Luis Valencia</span>
                    <span class="agenda-treat">Implante Dental</span>
                  </div>
                  <div class="agenda-card empty">
                    <span class="agenda-empty-text">Horario Disponible</span>
                  </div>
                </div>
                <div class="agenda-view__col">
                  <span class="col-title">Sillón C - Estética</span>
                  <div class="agenda-card success">
                    <span class="agenda-time">09:30 AM</span>
                    <span class="agenda-patient">Sofía Castro</span>
                    <span class="agenda-treat">Blanqueamiento</span>
                  </div>
                  <div class="agenda-card primary">
                    <span class="agenda-time">12:00 PM</span>
                    <span class="agenda-patient">Alejandro Ruiz</span>
                    <span class="agenda-treat">Resina</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SCREEN 2: Odontograma -->
          <div class="simulator__view transition-screen screen-hidden" id="screen-02">
            <div class="odontograma-view">
              <div class="odontograma-header">
                <h4 class="odontograma-title">Odontograma Interactivo (Arcada Superior)</h4>
                <span class="odontograma-subtitle">Toca una pieza para diagnosticar</span>
              </div>
              <div class="teeth-row">
                {
                  [18, 17, 16, 15, 14, 13, 12, 11, 21, 22, 23, 24, 25, 26, 27, 28].map((num) => (
                    <div class={`tooth-block ${num === 16 ? 'decayed' : ''} ${num === 24 ? 'treated' : ''}`} data-tooth={num}>
                      <span class="tooth-num">{num}</span>
                      <span class="tooth-shape"></span>
                    </div>
                  ))
                }
              </div>
              <div class="odontograma-details glass">
                <h5 class="detail-title">Historial Diagnóstico: Pieza 16</h5>
                <ul class="detail-list">
                  <li>
                    <span class="badge red">Caries Profunda</span>
                    <span class="detail-desc">Tratamiento sugerido: Resina compuesta.</span>
                  </li>
                  <li>
                    <span class="badge green">Limpieza Completa</span>
                    <span class="detail-desc">Realizada con éxito el mes pasado.</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- SCREEN 3: Portal del Paciente -->
          <div class="simulator__view transition-screen screen-hidden" id="screen-03">
            <div class="patient-view">
              <div class="patient-view__phone-frame glass">
                <div class="phone-screen">
                  <div class="phone-status-bar">
                    <span>9:41</span>
                    <span>5G</span>
                  </div>
                  <div class="phone-app-header">
                    <User size={18} class="text-primary" />
                    <span>Mi Portal de Salud</span>
                  </div>
                  <div class="phone-content">
                    <div class="phone-card orange-bg">
                      <span class="phone-card-subtitle">Próxima cita</span>
                      <span class="phone-card-title">Mañana a las 10:00 AM</span>
                      <span class="phone-card-desc">Dra. López — Endodoncia</span>
                      <button class="phone-card-btn" type="button">Confirmar Asistencia</button>
                    </div>
                    <h5 class="phone-section-title">Mi Historial</h5>
                    <div class="phone-history-item">
                      <span class="history-dot"></span>
                      <div>
                        <h6>Resina Fotocurable</h6>
                        <p>15 May 2026 — Sillón Estética</p>
                      </div>
                    </div>
                    <div class="phone-history-item">
                      <span class="history-dot"></span>
                      <div>
                        <h6>Radiografía Periapical</h6>
                        <p>12 Abr 2026 — Descargar PDF</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="patient-info-text">
                <h4>Portal OTP para el Paciente</h4>
                <p>Tus pacientes inician sesión con un código enviado a su celular. Sin crear cuentas, sin recordar contraseñas complejas.</p>
                <ul class="bullet-checklist">
                  <li><Check size={14} class="text-cta" /> Cero fricción en el login</li>
                  <li><Check size={14} class="text-cta" /> Confirmación con un solo tap</li>
                  <li><Check size={14} class="text-cta" /> Acceso seguro a presupuestos</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- SCREEN 4: Recordatorios -->
          <div class="simulator__view transition-screen screen-hidden" id="screen-04">
            <div class="whatsapp-view">
              <div class="chat-header">
                <div class="chat-avatar">CD</div>
                <div class="chat-user-info">
                  <span class="chat-username">Consultorio Dental</span>
                  <span class="chat-status">Recordatorios Automáticos</span>
                </div>
              </div>
              <div class="chat-messages">
                <div class="chat-bubble received">
                  <p>Hola Juan, te recordamos tu cita dental programada para mañana a las 10:00 AM. ¿Confirmas tu asistencia? Responde 1 para Confirmar o 2 para Cancelar.</p>
                  <span class="chat-time">9:00 AM</span>
                </div>
                <div class="chat-bubble sent">
                  <p>1</p>
                  <span class="chat-time">9:02 AM</span>
                </div>
                <div class="chat-bubble received">
                  <p>¡Gracias Juan! Tu cita ha sido confirmada automáticamente. Te esperamos en Av. Reforma 402. ¡Buen día!</p>
                  <span class="chat-time">9:02 AM</span>
                </div>
              </div>
              <div class="chat-footer">
                <span class="chat-input-placeholder">Solo respuestas automatizadas habilitadas</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Features Cards Grid -->
    <div class="solution__grid">
      {
        solution.features.map((feat) => {
          const IconComponent = IconMap[feat.icon as keyof typeof IconMap];
          return (
            <Card class="solution__card" hoverEffect={true}>
              <div class="solution__card-top">
                <span class="solution__card-icon animate-float" aria-hidden="true">
                  {IconComponent && <IconComponent size={28} class="text-accent" />}
                </span>
                <span class="solution__card-num" aria-hidden="true">
                  {feat.num}
                </span>
              </div>
              <h3 class="solution__card-title">{feat.title}</h3>
              <p class="solution__card-body">{feat.body}</p>
              <ul class="solution__card-list">
                {feat.bullets.map((bullet) => (
                  <li>
                    <Check size={14} class="text-cta" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </Card>
          );
        })
      }
    </div>
  </div>
</section>

<!-- Inline script for simulator logic -->
<script is:inline>
  (function () {
    const buttons = document.querySelectorAll('.simulator__nav-item');
    const screens = document.querySelectorAll('.simulator__view');
    const teeth = document.querySelectorAll('.tooth-block');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        buttons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        screens.forEach((screen) => {
          if (screen.id === targetId) {
            screen.classList.remove('screen-hidden');
            screen.classList.add('screen-visible');
          } else {
            screen.classList.remove('screen-visible');
            screen.classList.add('screen-hidden');
          }
        });
      });
    });

    // Simple tooth selection interactive mockup
    teeth.forEach((tooth) => {
      tooth.addEventListener('click', () => {
        teeth.forEach((t) => t.classList.remove('is-selected'));
        tooth.classList.add('is-selected');

        const toothNum = tooth.getAttribute('data-tooth');
        const detailsContainer = document.querySelector('.odontograma-details');
        const title = detailsContainer.querySelector('.detail-title');
        const list = detailsContainer.querySelector('.detail-list');

        title.textContent = `Historial Diagnóstico: Pieza ${toothNum}`;

        if (toothNum === '16') {
          list.innerHTML = `
            <li>
              <span class="badge red">Caries Profunda</span>
              <span class="detail-desc">Tratamiento sugerido: Resina compuesta.</span>
            </li>
            <li>
              <span class="badge green">Limpieza Completa</span>
              <span class="detail-desc">Realizada con éxito el mes pasado.</span>
            </li>
          `;
        } else if (toothNum === '24') {
          list.innerHTML = `
            <li>
              <span class="badge blue">Endodoncia terminada</span>
              <span class="detail-desc">Corona de porcelana cementada con éxito.</span>
            </li>
          `;
        } else {
          list.innerHTML = `
            <li>
              <span class="badge green">Pieza Sana</span>
              <span class="detail-desc">No presenta caries ni sarro visible.</span>
            </li>
          `;
        }
      });
    });
  })();
</script>

<style>
  .solution {
    background: transparent;
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .solution__eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    text-align: center;
  }

  .solution__headline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: var(--space-md);
    letter-spacing: -0.015em;
    text-align: center;
  }

  .solution__subheadline {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 60ch;
    line-height: 1.75;
    margin-bottom: var(--space-2xl);
    text-align: center;
    margin-inline: auto;
  }

  /* Interactive Simulator Container */
  .simulator {
    display: grid;
    grid-template-columns: 260px 1fr;
    background: rgba(15, 23, 42, 0.45);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-2xl);
    box-shadow: var(--shadow-lg);
  }

  /* Sidebar */
  .simulator__sidebar {
    background: rgba(10, 15, 30, 0.6);
    border-right: 1px solid var(--color-border);
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .simulator__sidebar-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sidebar-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .sidebar-dot.red { background: #ef4444; }
  .sidebar-dot.yellow { background: #f59e0b; }
  .sidebar-dot.green { background: #22c55e; }

  .simulator__sidebar-title {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-left: var(--space-xs);
  }

  .simulator__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .simulator__nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.75rem var(--space-sm);
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-muted);
    text-align: left;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
  }

  .simulator__nav-item:hover {
    background: rgba(255, 255, 255, 0.03);
    color: var(--color-text);
  }

  .simulator__nav-item.is-active {
    background: rgba(56, 189, 248, 0.08);
    color: var(--color-primary);
    border-color: rgba(56, 189, 248, 0.2);
  }

  .nav-item-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Screen Frame */
  .simulator__screen {
    display: flex;
    flex-direction: column;
    background: rgba(10, 15, 30, 0.2);
    min-height: 480px;
    position: relative;
  }

  .simulator__screen-header {
    height: 60px;
    border-bottom: 1px solid var(--color-border);
    padding: 0 var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(10, 15, 30, 0.3);
  }

  .simulator__search-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    width: 280px;
    border-radius: var(--radius-sm);
  }

  .search-indicator {
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--color-text-muted);
    border-radius: 50%;
  }

  .simulator__user-profile {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .user-avatar {
    width: 32px;
    height: 32px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .user-name {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .simulator__screen-content {
    flex: 1;
    padding: var(--space-md);
    position: relative;
    overflow: hidden;
  }

  .simulator__view {
    width: calc(100% - 2 * var(--space-md));
    height: calc(100% - 2 * var(--space-md));
  }

  /* SCREEN 1: Agenda Styles */
  .agenda-view {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
  }

  .agenda-view__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .agenda-view__title {
    font-size: 1.05rem;
    font-weight: 700;
  }

  .btn-mini {
    background: var(--color-primary);
    color: white;
    border: none;
    padding: 0.4rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .agenda-view__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    flex: 1;
  }

  .agenda-view__col {
    background: rgba(255, 255, 255, 0.01);
    border: 1px dashed rgba(255, 255, 255, 0.05);
    padding: var(--space-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .col-title {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
    text-align: center;
  }

  .agenda-card {
    border: 1px solid var(--color-border);
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-radius: var(--radius-sm);
    background: rgba(15, 23, 42, 0.6);
  }

  .agenda-card.primary { border-left: 3px solid var(--color-primary); }
  .agenda-card.secondary { border-left: 3px solid var(--color-accent); }
  .agenda-card.warning { border-left: 3px solid #f59e0b; }
  .agenda-card.success { border-left: 3px solid var(--color-cta); }
  
  .agenda-card.empty {
    border: 1px dashed rgba(255, 255, 255, 0.05);
    background: transparent;
    justify-content: center;
    align-items: center;
    height: 70px;
  }

  .agenda-empty-text {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.15);
    font-weight: 500;
  }

  .agenda-time {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .agenda-patient {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .agenda-treat {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* SCREEN 2: Odontograma Styles */
  .odontograma-view {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
  }

  .odontograma-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .odontograma-title {
    font-size: 1.05rem;
    font-weight: 700;
  }

  .odontograma-subtitle {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .teeth-row {
    display: flex;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--color-border);
    padding: var(--space-sm);
    gap: 4px;
    overflow-x: auto;
  }

  .tooth-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 0.4rem;
    cursor: pointer;
    border: 1px solid transparent;
    min-width: 32px;
  }

  .tooth-block:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .tooth-block.is-selected {
    background: rgba(56, 189, 248, 0.1);
    border-color: var(--color-primary);
  }

  .tooth-num {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .tooth-shape {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.1);
    box-sizing: border-box;
  }

  .tooth-block.decayed .tooth-shape {
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.3);
  }

  .tooth-block.treated .tooth-shape {
    border-color: #3b82f6;
    background: rgba(59, 130, 246, 0.3);
  }

  .odontograma-details {
    padding: var(--space-sm) var(--space-md);
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid var(--color-border);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .detail-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .detail-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .detail-list li {
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .badge {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }
  .badge.red { background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }
  .badge.green { background: rgba(34, 197, 94, 0.2); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3); }
  .badge.blue { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }

  .detail-desc {
    color: var(--color-text-muted);
  }

  /* SCREEN 3: Patient View Styles */
  .patient-view {
    display: grid;
    grid-template-columns: 180px 1fr;
