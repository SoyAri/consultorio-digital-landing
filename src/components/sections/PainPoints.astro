---
import { siteConfig } from '../../config/site';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import { Clock, MessageSquare, Calendar, Folder, ClipboardList, MessageCircle, FolderOpen } from 'lucide-astro';

const { painPoints } = siteConfig;

const IconMap = {
  clock: Clock,
  'message-square': MessageSquare,
  calendar: Calendar,
  folder: Folder,
  'clipboard-list': ClipboardList,
  'message-circle': MessageCircle,
  'folder-open': FolderOpen,
};
---

<section id="pain-points" class="pain-points">
  <!-- Imagen decorativa sutil en el hero -->
  <div class="pain-deco pain-deco--tooth" aria-hidden="true">
    <img src="/images/diente.webp" alt="" />
  </div>
  <div class="container">
    <!-- Hero: 2 columnas -->
    <div class="pain-points__hero">
      <!-- Columna izquierda: texto principal -->
      <div class="pain-points__hero-text animate-slide-in-left">
        <p class="pain-points__eyebrow">{painPoints.eyebrow}</p>
        <h1 class="pain-points__headline">
          {painPoints.headline}
        </h1>
        <p class="pain-points__subheadline">
          {painPoints.subheadline}
        </p>
        <Button
          variant="cta"
          class="pain-points__cta"
          onclick="window.$crisp && window.$crisp.push(['do', 'chat:open'])"
        >
          {painPoints.ctaText}
        </Button>
      </div>

      <!-- Columna derecha: visual de impacto -->
      <div class="pain-points__hero-visual animate-fade-in delay-2">
        <!-- Imagen flotante del producto -->
        <div class="hero-product-img" aria-hidden="true">
          <img src="/images/Compu.webp" alt="Consultorio Digital en pantalla" />
        </div>
        <div class="pain-points__impact-card glass">
          <p class="pain-points__impact-label">{painPoints.impactLabel}</p>
          <ul class="pain-points__impact-list">
            {
              painPoints.impacts.map((imp) => {
                const IconComponent = IconMap[imp.icon as keyof typeof IconMap];
                return (
                  <li class="transition-all-cool">
                    <span class="impact-icon-box" aria-hidden="true">
                      {IconComponent && <IconComponent size={18} />}
                    </span>
                    <span>
                      <strong>{imp.title}</strong> {imp.desc}
                    </span>
                  </li>
                );
              })
            }
          </ul>
          
          <div class="pain-points__impact-stat animate-pulse-glow">
            <span class="stat-number">{painPoints.stat.number}</span>
            <span class="stat-text">{painPoints.stat.text}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Cards de pain points -->
    <div class="pain-points__cards animate-slide-up delay-3">
      {
        painPoints.cards.map((card, index) => {
          const IconComponent = IconMap[card.icon as keyof typeof IconMap];
          const cardAccents = ['var(--color-primary)', 'var(--color-cta)', 'var(--color-accent)'];
          const cardAccentsMuted = ['var(--color-primary-light)', 'var(--color-cta-light)', 'var(--color-accent-light)'];
          return (
            <Card class="pain-points__card" hoverEffect={true} style={`--card-accent: ${cardAccents[index]}; --card-accent-muted: ${cardAccentsMuted[index]}`}>
              <div class="pain-points__card-icon-wrap" aria-hidden="true">
                {IconComponent && <IconComponent size={24} />}
              </div>
              <h3 class="pain-points__card-title">{card.title}</h3>
              <p class="pain-points__card-body">{card.body}</p>
            </Card>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .pain-points {
    background:
      radial-gradient(ellipse at 90% 30%, rgba(37, 99, 235, 0.07) 0%, transparent 55%),
      radial-gradient(ellipse at 100% 0%, rgba(14, 116, 144, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 10% 90%, rgba(56, 189, 248, 0.04) 0%, transparent 45%);
    padding: var(--space-sm) 0 var(--space-2xl);
    overflow: hidden;
    position: relative;
  }

  [data-theme="dark"] .pain-points {
    background:
      radial-gradient(ellipse at 90% 30%, rgba(56, 189, 248, 0.08) 0%, transparent 55%),
      radial-gradient(ellipse at 100% 0%, rgba(14, 116, 144, 0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 10% 90%, rgba(56, 189, 248, 0.05) 0%, transparent 45%);
  }

  /* Vertical left accent line */
  .pain-points::before {
    content: '';
    position: absolute;
    left: 0;
    top: 15%;
    height: 70%;
    width: 3px;
    background: linear-gradient(180deg, transparent, var(--color-primary), transparent);
    opacity: 0.25;
    pointer-events: none;
    z-index: 0;
  }

  .pain-deco {
    position: absolute;
    pointer-events: none;
    z-index: 0;
  }

  .pain-deco--tooth {
    top: -40px;
    left: -60px;
    width: 340px;
    opacity: 0.07;
    transform: rotate(-20deg);
    transition: opacity 0.3s;
  }

  [data-theme="dark"] .pain-deco--tooth {
    opacity: 0.12;
  }

  /* Hero 2 columnas */
  .pain-points__hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
    min-height: calc(72vh - var(--nav-height));
    padding: var(--space-md) 0 var(--space-md);
  }

  .pain-points__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.4rem 1rem 0.4rem 0.7rem;
    background: var(--color-primary-light);
    border: 1px solid var(--color-primary-muted);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .pain-points__eyebrow::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--color-primary);
    border-radius: 50%;
    flex-shrink: 0;
    animation: eyebrow-pulse 2.2s ease-in-out infinite;
  }

  @keyframes eyebrow-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.75); }
  }

  .pain-points__headline {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
  }

  .pain-points__subheadline {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: var(--space-lg);
    max-width: 55ch;
  }

  .pain-points__cta {
    font-size: 1.05rem;
    padding: 0.9rem 2.25rem;
  }

  /* Imagen flotante del producto */
  .hero-product-img {
    text-align: center;
    margin-bottom: var(--space-md);
  }

  .hero-product-img img {
    width: 100%;
    max-width: 380px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    opacity: 0.92;
    animation: float 5s ease-in-out infinite;
    filter: drop-shadow(0 20px 40px rgba(37, 99, 235, 0.18));
    transition: filter 0.3s ease;
  }

  [data-theme="dark"] .hero-product-img img {
    opacity: 0.88;
    filter: drop-shadow(0 20px 40px rgba(56, 189, 248, 0.22));
  }

  /* Tarjeta visual derecha */
  .pain-points__impact-card {
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .pain-points__impact-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  }

  .pain-points__impact-label {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
    padding-top: var(--space-xs);
  }

  .pain-points__impact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: var(--space-md);
  }

  .pain-points__impact-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pain-points__impact-list li:hover {
    background: rgba(37, 99, 235, 0.04);
    border-color: rgba(37, 99, 235, 0.1);
    transform: translateX(6px);
    color: var(--color-text);
  }

  [data-theme="dark"] .pain-points__impact-list li:hover {
    background: rgba(56, 189, 248, 0.05);
    border-color: rgba(56, 189, 248, 0.12);
  }

  .impact-icon-box {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .pain-points__impact-list li:hover .impact-icon-box {
    background: var(--color-primary-muted);
  }

  .pain-points__impact-list strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .pain-points__impact-stat {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    color: white;
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    box-shadow: 0 8px 24px -6px rgba(37, 99, 235, 0.45);
    position: relative;
    overflow: hidden;
  }

  .pain-points__impact-stat::after {
    content: '';
    position: absolute;
    top: -50%; right: -20%;
    width: 120px;
    height: 120px;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 50%;
    pointer-events: none;
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    flex-shrink: 0;
    letter-spacing: -0.02em;
  }

  .stat-text {
    font-size: 0.88rem;
    line-height: 1.45;
    opacity: 0.95;
    font-weight: 600;
  }

  /* Cards */
  .pain-points__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .pain-points__card {
    padding: var(--space-lg);
    border-top: 3px solid var(--card-accent, var(--color-primary)) !important;
  }

  .pain-points__card-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--card-accent-muted, var(--color-primary-light));
    color: var(--card-accent, var(--color-primary));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .pain-points__card:hover .pain-points__card-icon-wrap {
    transform: scale(1.08) rotate(3deg);
  }

  .pain-points__card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .pain-points__card-body {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  @media (max-width: 992px) {
    .pain-points__hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: var(--space-lg) 0 var(--space-md);
    }

    .pain-points__cards {
      grid-template-columns: 1fr;
    }

    /* Ocultar la imagen flotante en móvil para no duplicar visual */
    .hero-product-img {
      display: none;
    }
  }
</style>
