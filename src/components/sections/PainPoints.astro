---
import { siteConfig } from '../../config/site';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';

const { painPoints } = siteConfig;
---

<section id="pain-points" class="pain-points">
  <div class="container">
    <!-- Hero: 2 columnas -->
    <div class="pain-points__hero">
      <!-- Columna izquierda: texto principal -->
      <div class="pain-points__hero-text animate-slide-in-left">
        <p class="pain-points__eyebrow">{painPoints.eyebrow}</p>
        <h1 class="pain-points__headline">
          {painPoints.headline}
        </h1>
        <p class="pain-points__subheadline">
          {painPoints.subheadline}
        </p>
        <Button
          variant="cta"
          class="pain-points__cta"
          onclick="window.$crisp && window.$crisp.push(['do', 'chat:open'])"
        >
          {painPoints.ctaText}
        </Button>
      </div>

      <!-- Columna derecha: visual de impacto -->
      <div class="pain-points__hero-visual animate-fade-in delay-2">
        <div class="pain-points__impact-card glass">
          <p class="pain-points__impact-label">{painPoints.impactLabel}</p>
          <ul class="pain-points__impact-list">
            {
              painPoints.impacts.map((imp) => (
                <li class="transition-all-cool">
                  <span class="impact-icon animate-float" aria-hidden="true">
                    {imp.icon}
                  </span>
                  <span>
                    <strong>{imp.title}</strong> {imp.desc}
                  </span>
                </li>
              ))
            }
          </ul>
          
          <div class="pain-points__impact-stat animate-pulse-glow">
            <span class="stat-number">{painPoints.stat.number}</span>
            <span class="stat-text">{painPoints.stat.text}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Cards de pain points -->
    <div class="pain-points__cards animate-slide-up delay-3">
      {
        painPoints.cards.map((card, index) => (
          <Card class="pain-points__card" hoverEffect={true}>
            <div class="pain-points__card-icon animate-float" aria-hidden="true" style={`animation-delay: ${index * 0.3}s`}>
              {card.icon}
            </div>
            <h3 class="pain-points__card-title">{card.title}</h3>
            <p class="pain-points__card-body">{card.body}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pain-points {
    background: radial-gradient(circle at 80% 20%, hsl(var(--hue-primary), 80%, 95%) 0%, var(--color-bg) 50%);
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  /* Hero 2 columnas */
  .pain-points__hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-xl);
    align-items: center;
    min-height: calc(85vh - var(--nav-height));
    padding: var(--space-lg) 0 var(--space-2xl);
  }

  .pain-points__eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .pain-points__headline {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
  }

  .pain-points__subheadline {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: var(--space-lg);
    max-width: 55ch;
  }

  .pain-points__cta {
    font-size: 1.05rem;
    padding: 0.9rem 2.25rem;
  }

  /* Tarjeta visual derecha */
  .pain-points__impact-card {
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .pain-points__impact-label {
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .pain-points__impact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .pain-points__impact-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
  }

  .pain-points__impact-list li:hover {
    background: rgba(255, 255, 255, 0.4);
    transform: translateX(4px);
  }

  .impact-icon {
    font-size: 1.35rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
    display: inline-block;
  }

  .pain-points__impact-list strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .pain-points__impact-stat {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: white;
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    box-shadow: var(--shadow-md);
  }

  .stat-number {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    flex-shrink: 0;
  }

  .stat-text {
    font-size: 0.9rem;
    line-height: 1.4;
    opacity: 0.95;
    font-weight: 500;
  }

  /* Cards */
  .pain-points__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .pain-points__card {
    padding: var(--space-lg);
  }

  .pain-points__card-icon {
    font-size: 2.25rem;
    margin-bottom: var(--space-xs);
    line-height: 1;
    display: inline-block;
  }

  .pain-points__card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .pain-points__card-body {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  @media (max-width: 992px) {
    .pain-points__hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: var(--space-lg) 0 var(--space-md);
    }

    .pain-points__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
